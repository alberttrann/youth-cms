# =============================================================================
# youth-cms — Environment template (gitignored, use .env.local for local dev)
# =============================================================================
# Copy this to `.env.local` and fill in real values.
# For local dev: `npm run dev:local` reads from `.env.local`
# For production: deploy platform reads from `.env` or secrets manager
# =============================================================================

# ----- Server -----
HOST=0.0.0.0
PORT=1337
NODE_ENV=development
PUBLIC_URL=http://localhost:1337
ADMIN_PATH=/admin

# ----- App secrets (rotate if leaked) -----
# Generate with: openssl rand -base64 16  (each one)
APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ----- Database -----
# Option 1: SQLite (quick local setup, no persistence across machines)
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

# Option 2: PostgreSQL (Neon, Supabase, etc. — recommended for shared data)
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
# DATABASE_SSL=true

DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
DATABASE_URL=
DATABASE_SSL=false

# ----- Cloudinary (media uploads) -----
# Sign up at https://cloudinary.com → Console → Account Details.
# Provider is wired in `config/plugins.ts`.
CLOUDINARY_KEY=YOUR_CLOUDINARY_KEY
CLOUDINARY_NAME=YOUR_CLOUDINARY_NAME
CLOUDINARY_SECRET=YOUR_CLOUDINARY_SECRET

# ----- Feature flags (Strapi admin telemetry) -----
FLAG_NPS=true
FLAG_PROMOTE_EE=true
FLAG_DOC_LINKS=true

# ----- Webhooks -----
WEBHOOKS_POPULATE_RELATIONS=false