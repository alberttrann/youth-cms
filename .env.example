# =============================================================================
# youth-cms — Strapi 5 environment template
# =============================================================================
# Copy to `.env.local` (gitignored) and fill in real values. Start local dev
# with `npm run dev:local`; Strapi only reads another env file when ENV_PATH
# is set explicitly.
# =============================================================================

# ----- Server -----
HOST=0.0.0.0
PORT=1337
NODE_ENV=development
PUBLIC_URL=http://localhost:1337
ADMIN_PATH=/admin

# ----- App secrets (rotate if leaked) -----
# Generate with: openssl rand -base64 16  (each one)
APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ----- Database -----
# Use 'sqlite' for zero-setup local dev. Use 'postgres' (Neon / Supabase / etc.)
# for any environment that needs to persist data across machines.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Postgres connection (only required when DATABASE_CLIENT=postgres).
# Neon example:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=
DATABASE_SSL=false

# ----- Cloudinary (media uploads) -----
# Sign up at https://cloudinary.com → Console → Account Details.
# Provider is wired in `config/plugins.ts`.
CLOUDINARY_KEY=658835419561867
CLOUDINARY_NAME=mutcixn2
CLOUDINARY_SECRET=I3ZBbU5VVVEwtOe4QKczHa4-nU4

# ----- Feature flags (Strapi admin telemetry) -----
FLAG_NPS=true
FLAG_PROMOTE_EE=true
FLAG_DOC_LINKS=true

# ----- Webhooks -----
WEBHOOKS_POPULATE_RELATIONS=false