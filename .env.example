# youth-cms — Environment template
# Copy this file to `.env.local` and replace placeholder values.

# ----- Server -----
# Host address where Strapi listens. Use 0.0.0.0 for containers and remote access.
HOST=0.0.0.0
# Port where Strapi listens.
PORT=1337
# Runtime environment. Use production when deploying.
NODE_ENV=development

# ----- App secrets -----
# Comma-separated keys used to sign Strapi application data, sessions, and cookies.
# Generate four values with: openssl rand -base64 16
APP_KEYS=replace-with-key-1,replace-with-key-2,replace-with-key-3,replace-with-key-4
# Salt used to secure Strapi API tokens.
API_TOKEN_SALT=replace-with-a-random-secret
# Secret used to sign Strapi Admin login JWTs.
ADMIN_JWT_SECRET=replace-with-a-random-secret
# Salt used to secure Strapi data transfer tokens.
TRANSFER_TOKEN_SALT=replace-with-a-random-secret
# Encryption key used for sensitive Strapi Admin data.
ENCRYPTION_KEY=replace-with-a-random-secret

# ----- Database -----
# Database client used by Strapi. Use sqlite for local development or postgres in production.
DATABASE_CLIENT=sqlite
# SQLite database file path. Used when DATABASE_CLIENT=sqlite.
DATABASE_FILENAME=.tmp/data.db
# Database connection URL. Used when DATABASE_CLIENT=postgres.
DATABASE_URL=
# Enable SSL for the database connection.
DATABASE_SSL=false

# ----- Cloudinary (media uploads) -----
# Cloudinary API key, cloud name, and API secret for media uploads.
CLOUDINARY_KEY=replace-with-cloudinary-key
CLOUDINARY_NAME=replace-with-cloudinary-name
CLOUDINARY_SECRET=replace-with-cloudinary-secret

# Enable or disable the NPS feature in Strapi Admin.
FLAG_NPS=true
# Enable or disable documentation links in Strapi Admin.
FLAG_DOC_LINKS=true

# ----- Preview -----
# Frontend URL used by Strapi Admin Preview.
CLIENT_URL=http://localhost:5173
# Shared secret used to authorize preview requests.
PREVIEW_SECRET=replace-with-a-random-secret

# ----- Webhooks -----
# Populate relations in webhook payloads when enabled.
WEBHOOKS_POPULATE_RELATIONS=false
