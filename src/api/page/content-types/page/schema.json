{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Pages (Custom Content)",
    "description": "Dynamic custom content pages with flexible block layout"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "config": {
    "layouts": {
      "list": [
        "title",
        "slug",
        "updatedAt"
      ],
      "edit": [
        [
          { "name": "title", "size": 6 },
          { "name": "slug", "size": 6 }
        ],
        [
          { "name": "seo", "size": 12 }
        ],
        [
          { "name": "contentBlocks", "size": 12 }
        ]
      ]
    },
    "metadatas": {
      "title": {
        "edit": {
          "label": "Page Title",
          "placeholder": "e.g. Annual Summit 2026 / Introduction to Y.O.U Program",
          "description": "Internal and default display title for the page."
        },
        "list": {
          "label": "Title",
          "searchable": true,
          "sortable": true
        }
      },
      "slug": {
        "edit": {
          "label": "URL Slug",
          "placeholder": "annual-summit-2026",
          "description": "Unique URL identifier for the page (e.g. /pages/annual-summit-2026)."
        },
        "list": {
          "label": "Slug",
          "searchable": true
        }
      },
      "seo": {
        "edit": {
          "label": "SEO & Social Sharing Metadata",
          "description": "Configure title tag, meta description, and social share image."
        }
      },
      "contentBlocks": {
        "edit": {
          "label": "Content Layout (Dynamic Sections)",
          "description": "Add, remove, and reorder sections to construct the page layout."
        }
      }
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "contentBlocks": {
      "type": "dynamiczone",
      "components": [
        "sections.hero",
        "sections.rich-text",
        "sections.media-text",
        "sections.stats-grid",
        "sections.cta-banner",
        "sections.image-gallery",
        "sections.faq-section",
        "sections.featured-projects",
        "sections.featured-members",
        "sections.team-grid",
        "sections.embed",
        "sections.feature-grid",
        "sections.image-text-grid"
      ]
    }
  }
}