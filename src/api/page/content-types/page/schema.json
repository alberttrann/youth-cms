{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Pages (Custom Content)",
    "description": "Dynamic custom content pages with flexible block layout"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "config": {
    "layouts": {
      "list": [
        "title",
        "slug",
        "updatedAt"
      ],
      "edit": [
        [
          { "name": "title", "size": 6 },
          { "name": "slug", "size": 6 }
        ],
        [
          { "name": "seo", "size": 12 }
        ],
        [
          { "name": "contentBlocks", "size": 12 }
        ]
      ]
    },
    "metadatas": {
      "title": {
        "edit": {
          "label": "Page Title",
          "placeholder": "VD: Annual Summit 2026 / Giới thiệu chương trình Y.O.U",
          "description": "Tiêu đề của trang (dùng cho quản lý nội bộ và hiển thị mặc định)."
        },
        "list": {
          "label": "Title",
          "searchable": true,
          "sortable": true
        }
      },
      "slug": {
        "edit": {
          "label": "URL Slug",
          "placeholder": "annual-summit-2026",
          "description": "Đường dẫn URL định danh duy nhất của trang (VD: /pages/annual-summit-2026)."
        },
        "list": {
          "label": "Slug",
          "searchable": true
        }
      },
      "seo": {
        "edit": {
          "label": "SEO & Social Sharing Metadata",
          "description": "Cấu hình tiêu đề tab, mô tả thẻ mạng xã hội khi chia sẻ link."
        }
      },
      "contentBlocks": {
        "edit": {
          "label": "Content Layout (Dynamic Sections)",
          "description": "Tự do thêm, xóa, và kéo thả thay đổi vị trí các Section để xây dựng bố cục trang."
        }
      }
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "contentBlocks": {
      "type": "dynamiczone",
      "components": [
        "sections.hero",
        "sections.rich-text",
        "sections.media-text",
        "sections.stats-grid",
        "sections.cta-banner",
        "sections.image-gallery",
        "sections.faq-section",
        "sections.featured-projects",
        "sections.featured-members",
        "sections.team-grid",
        "sections.embed"
      ]
    }
  }
}