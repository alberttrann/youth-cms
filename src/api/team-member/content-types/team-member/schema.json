{
  "kind": "collectionType",
  "collectionName": "team_members",
  "info": {
    "singularName": "team-member",
    "pluralName": "team-members",
    "displayName": "Team-Member"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "config": {
    "layouts": {
      "list": ["name", "leadershipType", "continent", "displayOrder"],
      "edit": [
        [{ "name": "name", "size": 8 }, { "name": "leadershipType", "size": 4 }],
        [{ "name": "role", "size": 6 }, { "name": "displayOrder", "size": 3 }, { "name": "year", "size": 3 }],
        [{ "name": "continent", "size": 6 }, { "name": "regionGroup", "size": 6 }],
        [{ "name": "focusSdgs", "size": 12 }],
        [{ "name": "avatar", "size": 6 }, { "name": "activityImages", "size": 6 }],
        [{ "name": "bio", "size": 12 }],
        [{ "name": "socialLinks", "size": 12 }]
      ]
    },
    "metadatas": {
      "name": {
        "edit": { "label": "Họ và tên", "placeholder": "VD: Nguyen Minh Anh", "description": "Tên lãnh đạo hiển thị trên thẻ và modal." },
        "list": { "label": "Họ và tên" }
      },
      "leadershipType": {
        "edit": { "label": "Nhóm lãnh đạo", "description": "Chọn Executive Leadership hoặc Continental Director." },
        "list": { "label": "Nhóm" }
      },
      "role": {
        "edit": { "label": "Chức vụ", "placeholder": "VD: President & Chair" },
        "list": { "label": "Chức vụ" }
      },
      "displayOrder": {
        "edit": { "label": "Thứ tự hiển thị", "description": "Số nhỏ hơn hiển thị trước. Executive: President → Vice President → Secretary General." },
        "list": { "label": "Thứ tự" }
      },
      "continent": {
        "edit": { "label": "Châu lục", "description": "FE dùng để lọc Continental Directors." },
        "list": { "label": "Châu lục" }
      },
      "regionGroup": {
        "edit": { "label": "Khu vực", "description": "Bắt buộc với Director thuộc Asia; để trống với Executive." },
        "list": { "label": "Khu vực" }
      },
      "focusSdgs": {
        "edit": { "label": "Mục tiêu SDG trọng tâm", "description": "Tick các mục tiêu 1-17 theo UN SDG. Hệ thống tự loại trùng và chặn giá trị ngoài 1-17." },
        "list": { "label": "SDG" }
      },
      "avatar": {
        "edit": { "label": "Ảnh đại diện", "description": "Ảnh chân dung; FE hiển thị dạng hình tròn." },
        "list": { "label": "Ảnh" }
      },
      "activityImages": {
        "edit": { "label": "Ảnh hoạt động", "description": "Chọn nhiều ảnh hoạt động của lãnh đạo." },
        "list": { "label": "Ảnh hoạt động" }
      },
      "bio": {
        "edit": { "label": "Tiểu sử", "description": "Mỗi đoạn cách nhau bằng một dòng trống; FE hiển thị mỗi đoạn thành một paragraph." },
        "list": { "label": "Tiểu sử" }
      },
      "year": {
        "edit": { "label": "Thời gian hoạt động", "placeholder": "VD: 2020 - 2026" },
        "list": { "label": "Thời gian" }
      },
      "socialLinks": {
        "edit": { "label": "Liên kết mạng xã hội", "description": "Mỗi dòng gồm nền tảng + URL đầy đủ (https://...)." },
        "list": { "label": "Mạng xã hội" }
      }
    }
  },
  "attributes": {
    "name": { "type": "string" },
    "role": { "type": "string" },
    "leadershipType": {
      "type": "enumeration",
      "enum": ["executive", "continental-director"]
    },
    "displayOrder": { "type": "integer", "default": 0, "min": 0 },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "continent": {
      "type": "enumeration",
      "enum": ["Asia", "Africa", "America", "Australia", "Europe"]
    },
    "regionGroup": {
      "type": "enumeration",
      "enum": ["East Asia", "Southeast Asia", "South Asia", "Central Asia", "West Asia", "North Asia", "Africa", "America", "Australia", "Europe"]
    },
    "bio": { "type": "text" },
    "focusSdgs": {
      "type": "customField",
      "customField": "global::multi-enum",
      "options": {
        "choices": "1=No Poverty,2=Zero Hunger,3=Good Health,4=Quality Education,5=Gender Equality,6=Clean Water,7=Affordable Energy,8=Decent Work,9=Industry Innovation,10=Reduced Inequalities,11=Sustainable Cities,12=Responsible Consumption,13=Climate Action,14=Life Below Water,15=Life On Land,16=Peace Justice,17=Partnerships"
      }
    },
    "year": { "type": "string" },
    "activityImages": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "socialLinks": {
      "type": "component",
      "component": "shared.social-link",
      "repeatable": true
    }
  }
}
