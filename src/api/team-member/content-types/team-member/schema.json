{
  "kind": "collectionType",
  "collectionName": "team_members",
  "info": {
    "singularName": "team-member",
    "pluralName": "team-members",
    "displayName": "Leadership Team",
    "description": "Leadership team members (Executives & Continental Directors)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "config": {
    "layouts": {
      "list": ["name", "role", "leadershipType", "continent", "displayOrder"],
      "edit": [
        [
          { "name": "name", "size": 6 },
          { "name": "role", "size": 6 }
        ],
        [
          { "name": "leadershipType", "size": 4 },
          { "name": "displayOrder", "size": 4 },
          { "name": "year", "size": 4 }
        ],
        [
          { "name": "continent", "size": 4 },
          { "name": "regionGroup", "size": 8 }
        ],
        [{ "name": "bio", "size": 12 }],
        [{ "name": "focusSdgs", "size": 12 }],
        [
          { "name": "avatar", "size": 6 },
          { "name": "activityImages", "size": 6 }
        ],
        [{ "name": "socialLinks", "size": 12 }]
      ]
    },
    "metadatas": {
      "name": {
        "edit": {
          "label": "Name",
          "placeholder": "Full name"
        },
        "list": { "label": "Name" }
      },
      "role": {
        "edit": {
          "label": "Role/Title",
          "placeholder": "e.g., President & Chair, Continental Director"
        },
        "list": { "label": "Role" }
      },
      "leadershipType": {
        "edit": {
          "label": "Leadership Type",
          "description": "Distinguish between executive and continental director"
        },
        "list": { "label": "Type" }
      },
      "displayOrder": {
        "edit": {
          "label": "Display Order",
          "description": "Sort order in leadership list (ascending)"
        },
        "list": { "label": "Order" }
      },
      "year": {
        "edit": {
          "label": "Term Year",
          "placeholder": "e.g., 2026 - 2027"
        },
        "list": { "label": "Term" }
      },
      "continent": {
        "edit": {
          "label": "Continent",
          "description": "Primary continent of leadership"
        },
        "list": { "label": "Continent" }
      },
      "regionGroup": {
        "edit": {
          "label": "Region Group",
          "description": "More specific region within continent"
        },
        "list": { "label": "Region" }
      },
      "bio": {
        "edit": {
          "label": "Biography",
          "placeholder": "Personal statement / introduction (supports multiple paragraphs)"
        },
        "list": { "label": "Bio" }
      },
      "focusSdgs": {
        "edit": {
          "label": "Focus SDGs",
          "description": "Select relevant UN Sustainable Development Goals"
        },
        "list": { "label": "SDGs" }
      },
      "avatar": {
        "edit": {
          "label": "Profile Image",
          "description": "Square profile photo"
        },
        "list": { "label": "Avatar" }
      },
      "activityImages": {
        "edit": {
          "label": "Activity Images",
          "description": "Photos from leadership activities"
        },
        "list": { "label": "Activity Photos" }
      },
      "socialLinks": {
        "edit": {
          "label": "Social Links",
          "description": "LinkedIn, Instagram, Facebook, etc."
        },
        "list": { "label": "Social" }
      }
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "role": {
      "type": "string",
      "required": true
    },
    "leadershipType": {
      "type": "enumeration",
      "enum": ["executive", "continental-director"],
      "required": true
    },
    "displayOrder": {
      "type": "integer",
      "default": 0,
      "required": true
    },
    "year": {
      "type": "string"
    },
    "continent": {
      "type": "enumeration",
      "enum": ["Asia", "Africa", "America", "Australia", "Europe"],
      "required": true
    },
    "regionGroup": {
      "type": "enumeration",
      "enum": [
        "East Asia",
        "Southeast Asia",
        "South Asia",
        "Central Asia",
        "West Asia",
        "North Asia",
        "North Africa",
        "West Africa",
        "Central Africa",
        "East Africa",
        "Southern Africa",
        "North America",
        "Central America",
        "Caribbean",
        "South America",
        "Australia",
        "New Zealand",
        "Melanesia",
        "Micronesia",
        "Polynesia",
        "Northern Europe",
        "Western Europe",
        "Eastern Europe",
        "Southern Europe"
      ]
    },
    "bio": {
      "type": "text",
      "description": "Multi-paragraph biography (separated by double line breaks)"
    },
    "focusSdgs": {
      "type": "customField",
      "customField": "global::multi-enum",
      "options": {
        "choices": "1=SDG 1 – No Poverty,2=SDG 2 – Zero Hunger,3=SDG 3 – Good Health,4=SDG 4 – Quality Education,5=SDG 5 – Gender Equality,6=SDG 6 – Clean Water,7=SDG 7 – Affordable Energy,8=SDG 8 – Decent Work,9=SDG 9 – Industry Innovation,10=SDG 10 – Reduced Inequalities,11=SDG 11 – Sustainable Cities,12=SDG 12 – Responsible Consumption,13=SDG 13 – Climate Action,14=SDG 14 – Life Below Water,15=SDG 15 – Life On Land,16=SDG 16 – Peace Justice,17=SDG 17 – Partnerships"
      }
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "activityImages": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "socialLinks": {
      "type": "component",
      "component": "shared.social-link",
      "repeatable": true
    }
  }
}
