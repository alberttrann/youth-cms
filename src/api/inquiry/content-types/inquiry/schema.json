{
  "kind": "collectionType",
  "collectionName": "inquiries",
  "info": {
    "singularName": "inquiry",
    "pluralName": "inquiries",
    "displayName": "Inquiry",
    "description": "Contact inquiries submitted by website visitors"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "status": {
      "type": "enumeration",
      "enum": ["unread", "in_progress", "resolved", "archived"],
      "default": "unread"
    },
    "adminNotes": {
      "type": "text"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "string",
      "required": true,
      "regex": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "phone": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "required": true
    },
    "message": {
      "type": "text",
      "required": true
    }
  }
}