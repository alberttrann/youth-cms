{
  "kind": "collectionType",
  "collectionName": "faqs",
  "info": {
    "singularName": "faq",
    "pluralName": "faqs",
    "displayName": "FAQ"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "config": {
    "layouts": {
      "list": ["question", "answer", "displayOrder"],
      "edit": [
        [{ "name": "question", "size": 12 }],
        [{ "name": "answer", "size": 12 }],
        [{ "name": "displayOrder", "size": 12 }]
      ]
    },
    "metadatas": {
      "question": {
        "edit": {
          "label": "Question",
          "placeholder": "The FAQ question"
        },
        "list": { "label": "Question" }
      },
      "answer": {
        "edit": {
          "label": "Answer",
          "placeholder": "The FAQ answer"
        },
        "list": { "label": "Answer" }
      },
      "displayOrder": {
        "edit": {
          "label": "Display Order",
          "description": "Sort order in the FAQ list (ascending)"
        },
        "list": { "label": "Order" }
      }
    }
  },
  "attributes": {
    "question": {
      "type": "text"
    },
    "answer": {
      "type": "text"
    },
    "displayOrder": {
      "type": "integer",
      "default": 0,
      "required": true
    }
  }
}
