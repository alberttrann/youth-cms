        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "shortDescription": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "country": {
      "type": "string"
    },
    "continent": {
      "type": "enumeration",
      "enum": [
        "Asia",
        "Africa",
        "America",
        "Australia",
        "Europe"
      ]
    },
    "focusSdgs": {
      "type": "json"
    },
    "donationQr": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "period": {
      "type": "string"
    },
    "leader": {
      "type": "string"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "socialLinks": {
      "type": "component",
      "component": "shared.social-link",
