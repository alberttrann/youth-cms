{
  "collectionName": "components_shared_buttons",
  "info": {
    "displayName": "Button",
    "icon": "cursor",
    "description": "Call to action button or navigation link"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "solid",
        "outline",
        "white",
        "ghost",
        "link"
      ],
      "default": "solid",
      "required": true
    },
    "size": {
      "type": "enumeration",
      "enum": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md"
    },
    "isExternal": {
      "type": "boolean",
      "default": false
    },
    "target": {
      "type": "enumeration",
      "enum": [
        "_self",
        "_blank"
      ],
      "default": "_self"
    }
  }
}