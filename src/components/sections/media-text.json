{
  "collectionName": "components_sections_media_texts",
  "info": {
    "displayName": "Media & Text (2-Column)",
    "icon": "layout",
    "description": "Side-by-side media and rich story content"
  },
  "options": {},
  "attributes": {
    "eyebrow": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "text",
      "required": true
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "mediaPosition": {
      "type": "enumeration",
      "enum": [
        "left",
        "right"
      ],
      "default": "right"
    },
    "button": {
      "type": "component",
      "component": "shared.button",
      "repeatable": false
    },
    "style": {
      "type": "component",
      "component": "shared.section-style",
      "repeatable": false
    }
  }
}